# --- Virtual Environments (uv isolation) ---
.venv/
ai_env/
venv/
env/

# --- Python Operational Cache ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Build Output (wheels and source distributions) ---
dist/
build/
*.egg-info/

# --- Environment Configurations & Secrets ---
.env
.env.*
*.env
!.env.example
secrets.json

# --- IDEs and Workspace Metadata ---
# .vscode/* (not .vscode/) so the exceptions below can re-include shared config.
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp

# --- Claude Code (local, per-machine settings) ---
.claude/settings.local.json

# Track the shared setup (settings, agents, skills, rules, hooks) and nothing else under .claude/.
/.claude/*
!/.claude/settings.json
!/.claude/agents/
!/.claude/skills/
!/.claude/rules/
!/.claude/hooks/
.claude/transcripts/
# Backups taken before a .claude/ change (see docs/08_CLAUDE_SETUP.md).
.claude.bak-*/
# Implementation plans are working files for one task (.claude/skills/plan/SKILL.md): only the folder is tracked.
docs/plans/*
!docs/plans/.gitkeep

# --- Local Vector Store Data (Qdrant) and Logs ---
qdrant_storage/
*.log

# --- Frontend (Next.js) ---
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# --- OS Files ---
.DS_Store
Thumbs.db

# --- Local Databases and Runtime Data (demo SQLite, LangGraph checkpoints) ---
data/
*.db
*.sqlite3

# --- Terraform (state, plans, and real variable files never get committed) ---
.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
terraform.tfvars
backend.hcl

# --- The owner's local prompt note ---
# A project-agnostic prompt, not CloudDesk documentation, so it is not committed. docs/ holds numbered project documents.
docs/10_PROMPT_COST.md

# --- Private interview preparation (see docs/09_PHASE_DOCUMENTATION.md) ---
# The repository is public. The other documents in each internal/PhaseNN/ folder hold project documentation and are committed.
internal/Phase*/04_INTERVIEW_QNA.md
