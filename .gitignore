# --- Virtual Environments (uv isolation) ---
.venv/
ai_env/
venv/
env/

# --- Python Operational Cache ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Build Output (wheels and source distributions) ---
dist/
build/
*.egg-info/

# --- Environment Configurations & Secrets ---
.env
.env.*
*.env
!.env.example
secrets.json

# --- IDEs and Workspace Metadata ---
# .vscode/* (not .vscode/) so the exceptions below can re-include shared config.
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp

# --- Claude Code (local, per-machine settings) ---
.claude/settings.local.json

# --- Local Vector Store Data (Qdrant) and Logs ---
qdrant_storage/
*.log

# --- Frontend (Next.js) ---
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# --- OS Files ---
.DS_Store
Thumbs.db

# --- Local Databases and Runtime Data (demo SQLite, LangGraph checkpoints) ---
data/
*.db
*.sqlite3

# --- Terraform (state, plans, and real variable files never get committed) ---
.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
terraform.tfvars
backend.hcl
