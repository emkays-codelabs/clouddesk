# CloudDesk configuration. Copy to .env (git-ignored) and edit. Placeholders only: never commit real keys.
# get_settings() is cached, so restart the server after changing this file.

# --- Runtime ---
DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
JWT_SECRET=change-me-demo-only
SUPABASE_JWT_SECRET=

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/support.db
# ./data/checkpoints.db for a file-backed run, :memory: in tests
CHECKPOINT_DB_PATH=./data/checkpoints.db
# Empty uses fakeredis
REDIS_URL=
USE_FAKE_REDIS=true

# --- LLM and embeddings ---
# fake (default, offline) | openai | anthropic | ...
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384

# --- Vector store ---
# memory | qdrant
VECTOR_STORE=memory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clouddesk_knowledge

# --- Policy and limits ---
APPROVAL_REQUIRED_FOR_REFUNDS=true
MAX_REFUND_WITHOUT_APPROVAL=0
TOOL_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
SAMPLE_DATA_DIR=./sample_data

# --- Observability (LangSmith is optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clouddesk-support
