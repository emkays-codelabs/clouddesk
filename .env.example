# CloudDesk environment template. Placeholders only: never put a real key in this file.
#
#   1. Copy it:   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#   2. Put your own values in .env (git-ignored). The only value you MUST provide is LLM_API_KEY.
#   3. Start the stack:   docker compose up --build
#
# docker-compose.yml supplies the database (Postgres), Redis and Qdrant for the containers, so this
# file only holds your secrets and choices. get_settings() is cached: restart after changing .env.

# --- Auth ---
# Signs demo logins. Use a long random string, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Only when running against Supabase.
SUPABASE_JWT_SECRET=

# --- Language model (Euron, OpenAI-compatible) ---
# fake (offline, no key) | openai | euron | anthropic (not implemented)
LLM_PROVIDER=euron
# YOUR KEY GOES HERE. It is read by the backend only; the browser never sees it.
LLM_API_KEY=
LLM_BASE_URL=https://api.euron.one/api/v1/euri
# Fallback model. Each tier below falls back to it when left empty.
LLM_MODEL=euri-chat-smart
LLM_MODEL_FAST=openai/gpt-oss-120b-Turbo
LLM_MODEL_SMART=openai/gpt-oss-120b-Turbo
LLM_MODEL_REASONING=openai/gpt-oss-120b-Turbo
# Verified prices only, as {"model": [usd_per_million_input, usd_per_million_output]}. Leave empty when
# unknown: cost then shows "unavailable" instead of a made-up number. openai/gpt-oss-120b-Turbo is built in.
LLM_PRICING=

# --- Embeddings (change them, then POST /api/v1/knowledge/reindex as an admin) ---
EMBEDDING_PROVIDER=euron
EMBEDDING_MODEL=euri-embedding
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1024

# --- Vector store (local Qdrant container, no key needed) ---
VECTOR_STORE=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clouddesk_knowledge

# --- Local database password (the Postgres container) ---
# Not a Settings field: docker-compose.yml substitutes it. Change it for anything shared.
# POSTGRES_PASSWORD=clouddesk-local

# --- Policy and limits ---
APPROVAL_REQUIRED_FOR_REFUNDS=true
MAX_REFUND_WITHOUT_APPROVAL=0
TOOL_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
SAMPLE_DATA_DIR=./sample_data

# --- Values docker-compose.yml already sets (listed so the file names every setting) ---
# Change these only when running the backend directly on your machine, not in Docker.
DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite+aiosqlite:///./data/support.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
REDIS_URL=
USE_FAKE_REDIS=false

# --- Optional tracing (LangSmith) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clouddesk-support
